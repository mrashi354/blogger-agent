# --- Grok (xAI) -----------------------------------------------------------
# https://console.x.ai  -> API key
GROK_API_KEY=
# Model id, e.g. grok-4 or grok-3-mini. Never hardcoded, always read from here.
GROK_MODEL=

# --- Pixabay --------------------------------------------------------------
# https://pixabay.com/api/docs/ -> free API key
PIXABAY_API_KEY=

# --- Google OAuth (Desktop app client) ------------------------------------
# https://console.cloud.google.com -> Credentials -> OAuth client ID -> Desktop app
GOOGLE_CLIENT_ID=  
GOOGLE_CLIENT_SECRET=
# Printed by: python auth_setup.py
GOOGLE_REFRESH_TOKEN=

# --- Blogger ---------------------------------------------------------------
# The blog ID is the last path segment of your blog URL:
# https://myblog.blogspot.com/  ->  BLOG_ID=1234567890123456789
BLOG_ID=

# --- Publishing behaviour --------------------------------------------------
# true  = publish as draft (recommended for the first few runs)
# false = publish live
DRAFT_MODE=true

# --- Content settings ------------------------------------------------------
BLOG_NICHE=Personal Finance & Money
# Hinglish / English / Hindi
BLOG_LANGUAGE=Hinglish

# --- CI --------------------------------------------------------------------
# In GitHub Actions this is provided automatically from github.repository.
# Set it locally only if you want the CDN image URL printed in --dry-run.
# Format: your-github-username/your-repo-name
GITHUB_REPOSITORY=

# --- Own site (optional) ---------------------------------------------------
# Leave empty to skip the author-box link entirely.
# If both are set, a short "more tools" line is appended to each post.
SITE_URL=
SITE_NAME=